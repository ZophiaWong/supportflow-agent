VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend runtime state. Leave blank to use data/supportflow.sqlite3.
# SUPPORTFLOW_DB_PATH=/absolute/path/to/supportflow.sqlite3

# Optional LLM generation for classify_ticket and draft_reply.
# Copy this file to .env, then fill in real secrets there. Never commit .env.
SUPPORTFLOW_LLM_ENABLED=false
SUPPORTFLOW_LLM_MODEL=gpt-4o-mini
SUPPORTFLOW_LLM_BASE_URL=https://api.openai.com/v1
SUPPORTFLOW_LLM_TIMEOUT_SECONDS=20

# Use one of these key variables in your local .env.
OPENAI_API_KEY=
# SUPPORTFLOW_LLM_API_KEY=
